{
  "name": "@andyjudson/cubify-react",
  "version": "1.3.14",
  "type": "module",
  "description": "React wrappers for @andyjudson/cubify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyjudson/cubify.git"
  },

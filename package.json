{
  "name": "cubify",
  "version": "0.1.0",
  "description": "Clean-room 3×3 cube rendering and logic library",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./types/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "cd cubify-harness && vite",
    "build": "cd cubify-harness && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "cubing": "^0.63.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "cubing": "^0.63.3",
    "sharp": "^0.34.5",
    "three": "^0.170.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
